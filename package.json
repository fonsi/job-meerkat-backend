{
    "name": "jobmeerkat",
    "scripts": {
        "lint": "eslint --fix",
        "typecheck": "tsc --noEmit",
        "local": "npm run lint && sls invoke local --function",
        "scrap-company": "npm run local devScrapCompany -- --path src/company/infrastructure/dev/scrapCompany.event.json",
        "admin": "vite --config admin/vite.config.ts",
        "send-test-report": "npm run local devSendTestReport -- --path src/report/infrastructure/dev/sendTestReport.event.json",
        "generate-follower-growth-posts": "npm run local generateFollowerGrowthPosts -- --path src/social/infrastructure/dev/generateFollowerGrowthPosts.event.json",
        "backfill-job-post-cache": "npm run local backfillJobPostCache -- --path src/jobPost/infrastructure/dev/backfillJobPostCache.event.json",
        "deploy:dev": "npm run lint && serverless deploy -v",
        "deploy:prod": "npm run lint && serverless deploy -v --stage=production",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "prepare": "husky",
        "pre-commit": "lint-staged && npm run typecheck && npm test"
    },
    "devDependencies": {
        "@eslint/js": "^9.28.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^24.0.0",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@vitejs/plugin-react": "^5.0.0",
        "eslint": "^9.28.0",
        "globals": "^16.2.0",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "lint-staged": "^16.1.0",
        "postcss": "^8.5.6",
        "prettier": "^3.5.3",
        "serverless": "^4.15.1",
        "sharp": "^0.34.0",
        "ts-jest": "^29.3.4",
        "tsx": "^4.20.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.33.0",
        "vite": "^7.0.0"
    },
    "volta": {
        "node": "24.11.0"
    },
    "dependencies": {
        "@atproto/api": "^0.16.3",
        "@aws-sdk/client-api-gateway": "^3.821.0",
        "@aws-sdk/client-dynamodb": "^3.821.0",
        "@aws-sdk/client-lambda": "^3.821.0",
        "@aws-sdk/client-s3": "^3.821.0",
        "@aws-sdk/client-sqs": "^3.821.0",
        "@resvg/resvg-js": "^2.6.2",
        "cheerio": "^1.0.0",
        "mailgun.js": "^12.1.1",
        "openai": "^5.3.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "rollbar": "^2.26.5",
        "satori": "^0.33.4"
    },
    "lint-staged": {
        "*.{js,ts,tsx,mjs,json}": "prettier --list-different --write"
    }
}
